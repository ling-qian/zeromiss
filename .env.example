# 美业AI店长助手 配置文件
# 复制此文件为 .env 并填入真实值
# 也可以运行 python scripts/setup_env.py 交互式生成

# === LLM Provider 选择 ===
# 可选: deepseek（推荐，便宜中文好）/ minimax / openai
LLM_PROVIDER=deepseek

# === DeepSeek 配置（推荐） ===
# 获取API Key: https://platform.deepseek.com/
# 价格: 输入¥1/百万token, 输出¥2/百万token（比GPT便宜97%）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# === MiniMax 配置（备选） ===
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.5
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic

# === OpenAI 配置（备选） ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# === 数据库配置 ===
DATABASE_URL=sqlite:///data/store.db

# === Web 平台配置 ===
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_USERNAME=admin
WEB_PASSWORD=admin123
WEB_SECRET_KEY=change-me-to-a-random-secret-key

# === 微信通道配置（可选） ===
# 接入模式: wecom（企业微信，推荐）/ webhook（通用桥接）
# 不设置 WECHAT_MODE 则不启用微信通道
WECHAT_MODE=

# --- 企业微信配置（WECHAT_MODE=wecom 时必填）---
# 注册企业微信: https://work.weixin.qq.com/
# 创建自建应用 → 获取 CorpID、AgentId、Secret
# 设置接收消息回调 → 获取 Token、EncodingAESKey
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# --- Webhook配置（WECHAT_MODE=webhook 时必填）---
# 可对接任意微信桥接工具（Gewechat/WeChatBot/itchat-uos等）
# webhook_url 是消息发送接口地址
WECHAT_WEBHOOK_URL=
WECHAT_WEBHOOK_SECRET=

# === 其他配置 ===
CONFIDENCE_THRESHOLD=0.7
DAILY_SUMMARY_TIME=21:00
