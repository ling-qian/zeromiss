# ==================== BizBot AI 店长 配置模板 ====================
# 用法: cp .env.example .env  然后逐项填写（划掉的不要改，星号必填）

# ---------- 门店管理台登录（老板娘网页端） ----------
WEB_USERNAME=boss
WEB_PASSWORD=改成强密码          # *
WEB_SECRET_KEY=随机长字符串      # *  python3 -c "import secrets;print(secrets.token_urlsafe(48))"

# ---------- 大模型（三选一，默认 minimax） ----------
LLM_PROVIDER=minimax             # minimax / deepseek / openai
MINIMAX_API_KEY=                 # *（选 minimax 时必填）
MINIMAX_MODEL=MiniMax-Text-01
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ---------- 数据库 ----------
# 默认 SQLite（data/bizbot.db），单店规模足够；上量后换 PostgreSQL
# DATABASE_URL=sqlite:///data/bizbot.db

# ---------- 微信客服通道（合规对外接待，核心开关） ----------
# 前置: 企微后台开通「微信客服」→ 创建客服账号 → 开启 API（见 deploy/部署手册）
WECHAT_MODE=kf                   # kf=启用微信客服接待；留空=不启用
WECOM_CORP_ID=                   # * 企微后台-我的企业-企业ID（ww开头）
WECOM_KF_SECRET=                 # * 微信客服应用Secret（开启API后查看）
WECOM_KF_OPEN_KFID=              # * 客服账号ID（wk开头）
WECOM_KF_TOKEN=                  # * 开启API时自己填的Token（复制到此处）
WECOM_KF_AES_KEY=                # * 开启API时自己填的EncodingAESKey（43位）
WECOM_KF_POLL_INTERVAL=20        # 拉取轮询秒数（回调兜底）
WECOM_KF_HOLD_MINUTES=30         # 转人工后AI静默分钟数（分级授权）

# ---------- 店主通知（转人工提醒，走企微群机器人webhook） ----------
WECHAT_MODE_NOTE=kf模式与下方webhook通知互不影响
WECHAT_WEBHOOK_URL=              # 企微群机器人Webhook地址（转人工时@店主）
